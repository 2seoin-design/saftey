# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key   # dataIngestion.js 전용 (RLS 우회, 절대 프런트엔드에 노출 금지)
REACT_APP_SUPABASE_URL=https://xxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=anon-key         # backend/data/supabaseService.js 전용 (브라우저 노출 가능)

# TMAP (보행자 경로)
TMAP_APP_KEY=tmap-app-key

# 공공데이터포털 (data.go.kr) 서비스키 - CCTV/비상벨/보안등 표준데이터 공용
DATA_GO_KR_API_KEY=data-go-kr-service-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# 각 표준데이터 API 엔드포인트 (data.go.kr에서 발급받은 실제 URL로 교체)
CCTV_API_URL=
BELL_API_URL=
LIGHT_API_URL=
